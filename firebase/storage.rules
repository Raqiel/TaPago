rules_version = '2';

// Regras do Cloud Storage.
// Cole no Firebase Console > Storage > Regras.
//
// Alem de isolar por usuario, o limite de 2 MB por arquivo e a trava de custo:
// impede que alguem suba um video de 500 MB e estoure a franquia gratuita.
service firebase.storage {
  match /b/{bucket}/o {

    match /users/{userId}/{folder}/{fileName} {
      allow read: if request.auth != null
        && request.auth.uid == userId
        && folder in ['workouts', 'exercises'];

      allow write: if request.auth != null
        && request.auth.uid == userId
        && folder in ['workouts', 'exercises']
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null
        && request.auth.uid == userId
        && folder in ['workouts', 'exercises'];
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
